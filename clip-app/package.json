{
  "name": "phosphor-clips",
  "productName": "Phosphor Clips",
  "version": "1.3.0",
  "description": "Grab videos and GIFs from the web, trim them and sort them into a clip library for Phosphor Loop",
  "author": "Nick Hillson",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test:engine": "node test/engine-test.js",
    "test:vision": "node test/vision-test.js",
    "test:app": "node test/app-test.js",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.nhillson.phosphorclips",
    "productName": "Phosphor Clips",
    "asar": false,
    "files": [
      "src/**/*",
      "package.json",
      "!**/node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**",
      "!**/node_modules/@img/sharp-*-{linux,darwin}*/**",
      "!**/node_modules/**/*.{md,map,ts}"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "bin",
        "filter": [
          "*.exe"
        ]
      },
      {
        "from": "chrome-button",
        "to": "chrome-button"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Phosphor-Clips-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Phosphor Clips",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null,
    "npmRebuild": false,
    "protocols": [
      {
        "name": "Phosphor Clips",
        "schemes": [
          "phosphor-clips"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nhillson/phosphor-loop.git"
  }
}
