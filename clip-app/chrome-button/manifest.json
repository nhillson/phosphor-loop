{
  "manifest_version": 3,
  "name": "Send to Phosphor Clips",
  "version": "1.1.0",
  "description": "Mark the good part of a video with Start here and End here and grab just that part with Phosphor Clips, or send the page, a video, a GIF or a link.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Send to Phosphor Clips",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}
