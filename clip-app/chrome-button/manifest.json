{
  "manifest_version": 3,
  "name": "Send to Phosphor Clips",
  "version": "1.0.0",
  "description": "Send the page you're watching, a video, a GIF or a link from Chrome to Phosphor Clips, ready to grab.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Send to Phosphor Clips",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"]
}
